{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://unpkg.com/slicetest/schema/scenario.schema.json",
  "title": "slicetest YAML scenarios",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "scenarios"
  ],
  "properties": {
    "setup": {
      "type": "array",
      "description": "Steps run at the start of every scenario",
      "items": {
        "$ref": "#/$defs/step"
      }
    },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "steps"
        ],
        "properties": {
          "name": {
            "type": "string",
            "description": "May use {{field}} from `each` rows"
          },
          "each": {
            "type": "array",
            "items": {
              "type": "object"
            },
            "description": "Run once per row; row fields become variables"
          },
          "skip": {
            "type": "boolean"
          },
          "only": {
            "type": "boolean"
          },
          "timeout": {
            "type": "integer"
          },
          "steps": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/step"
            }
          }
        }
      }
    }
  },
  "$defs": {
    "step": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "stub",
            "on"
          ],
          "additionalProperties": false,
          "properties": {
            "stub": {
              "type": "string",
              "description": "Stub name (declared in `stubs`). Registers a route on it."
            },
            "name": {
              "type": "string",
              "description": "Label shown when this step fails"
            },
            "on": {
              "type": "string",
              "pattern": "^([A-Za-z]+|\\*)\\s+/\\S*$",
              "description": "METHOD /path, e.g. POST /polls"
            },
            "when": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "query": {
                  "type": "object"
                },
                "headers": {
                  "type": "object"
                },
                "json": {
                  "description": "Subset of the request JSON"
                },
                "body": {}
              }
            },
            "reply": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "status": {
                  "type": "integer"
                },
                "headers": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string"
                  }
                },
                "body": {
                  "description": "String, or anything else to send as JSON. May use {{call.params.x}}, {{call.json.x}}, {{call.query.x}}"
                }
              }
            },
            "sequence": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "status": {
                    "type": "integer"
                  },
                  "headers": {
                    "type": "object",
                    "additionalProperties": {
                      "type": "string"
                    }
                  },
                  "body": {
                    "description": "String, or anything else to send as JSON. May use {{call.params.x}}, {{call.json.x}}, {{call.query.x}}"
                  }
                }
              },
              "minItems": 1
            },
            "networkError": {
              "const": true
            },
            "times": {
              "type": "integer",
              "minimum": 0
            },
            "delay": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        {
          "type": "object",
          "required": [
            "request"
          ],
          "additionalProperties": false,
          "properties": {
            "request": {
              "type": "string",
              "description": "Request to the app: METHOD /path"
            },
            "name": {
              "type": "string",
              "description": "Label shown when this step fails"
            },
            "headers": {
              "type": "object"
            },
            "query": {
              "type": "object"
            },
            "json": {},
            "form": {
              "type": "object"
            },
            "body": {
              "type": "string"
            },
            "follow": {
              "type": "boolean"
            },
            "expect": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "status": {
                  "type": [
                    "integer",
                    "string"
                  ]
                },
                "headers": {
                  "type": "object"
                },
                "json": {
                  "description": "Subset of the response JSON"
                },
                "text": {}
              }
            },
            "capture": {
              "type": "object",
              "description": "Save values as variables for later steps, e.g. { pollId: json.id }",
              "additionalProperties": {
                "type": "string"
              }
            }
          }
        },
        {
          "type": "object",
          "required": [
            "insert",
            "rows"
          ],
          "additionalProperties": false,
          "properties": {
            "insert": {
              "type": "string",
              "description": "Table to insert into"
            },
            "name": {
              "type": "string",
              "description": "Label shown when this step fails"
            },
            "rows": {
              "type": [
                "object",
                "array"
              ]
            },
            "capture": {
              "type": "object",
              "description": "Save values as variables for later steps, e.g. { pollId: json.id }",
              "additionalProperties": {
                "type": "string"
              }
            }
          }
        },
        {
          "type": "object",
          "required": [
            "sql"
          ],
          "additionalProperties": false,
          "properties": {
            "sql": {
              "type": "string",
              "description": "SQL to run ($1, $2 … for params)"
            },
            "name": {
              "type": "string",
              "description": "Label shown when this step fails"
            },
            "params": {
              "type": "array"
            },
            "expect": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "rows": {
                  "type": "array",
                  "description": "Rows in order; each row may omit columns"
                },
                "count": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            },
            "capture": {
              "type": "object",
              "description": "Save values as variables for later steps, e.g. { pollId: json.id }",
              "additionalProperties": {
                "type": "string"
              }
            },
            "within": {
              "type": "integer",
              "minimum": 1,
              "description": "Retry this step for up to this many milliseconds, for effects the app applies asynchronously"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "db"
          ],
          "additionalProperties": false,
          "properties": {
            "db": {
              "type": "string",
              "description": "Table to read"
            },
            "name": {
              "type": "string",
              "description": "Label shown when this step fails"
            },
            "where": {
              "type": "object",
              "description": "null = IS NULL, list = IN"
            },
            "orderBy": {
              "type": [
                "string",
                "array"
              ]
            },
            "expect": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "rows": {
                  "type": "array",
                  "description": "Rows in order; each row may omit columns"
                },
                "count": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            },
            "capture": {
              "type": "object",
              "description": "Save values as variables for later steps, e.g. { pollId: json.id }",
              "additionalProperties": {
                "type": "string"
              }
            },
            "within": {
              "type": "integer",
              "minimum": 1,
              "description": "Retry this step for up to this many milliseconds, for effects the app applies asynchronously"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "received"
          ],
          "additionalProperties": false,
          "properties": {
            "received": {
              "type": "string",
              "description": "Stub name. Asserts the app called it."
            },
            "name": {
              "type": "string",
              "description": "Label shown when this step fails"
            },
            "call": {
              "type": "string",
              "pattern": "^([A-Za-z]+|\\*)\\s+/\\S*$",
              "description": "METHOD /path, e.g. POST /polls"
            },
            "when": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "query": {
                  "type": "object"
                },
                "headers": {
                  "type": "object"
                },
                "json": {
                  "description": "Subset of the request JSON"
                },
                "body": {}
              }
            },
            "times": {
              "type": "integer",
              "minimum": 0,
              "description": "Exact count; default: at least once"
            },
            "within": {
              "type": "integer",
              "minimum": 1,
              "description": "Retry this step for up to this many milliseconds, for effects the app applies asynchronously"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "changes"
          ],
          "additionalProperties": false,
          "properties": {
            "changes": {
              "type": "object",
              "description": "The database changed exactly in these tables since the scenario started (or the last checkpoint). Unlisted tables must be unchanged.",
              "additionalProperties": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "inserted": {
                    "oneOf": [
                      {
                        "type": "integer",
                        "minimum": 0
                      },
                      {
                        "type": "array",
                        "items": {
                          "type": "object"
                        }
                      }
                    ],
                    "description": "Count, or subset rows"
                  },
                  "updated": {
                    "oneOf": [
                      {
                        "type": "integer",
                        "minimum": 0
                      },
                      {
                        "type": "array",
                        "items": {
                          "type": "object"
                        }
                      }
                    ],
                    "description": "Count, or subset rows (after the update)"
                  },
                  "deleted": {
                    "oneOf": [
                      {
                        "type": "integer",
                        "minimum": 0
                      },
                      {
                        "type": "array",
                        "items": {
                          "type": "object"
                        }
                      }
                    ],
                    "description": "Count, or subset rows"
                  }
                }
              }
            },
            "name": {
              "type": "string",
              "description": "Label shown when this step fails"
            },
            "within": {
              "type": "integer",
              "minimum": 1,
              "description": "Retry this step for up to this many milliseconds, for effects the app applies asynchronously"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "checkpoint"
          ],
          "additionalProperties": false,
          "properties": {
            "checkpoint": {
              "const": true,
              "description": "Later `changes` steps only see what happens after this step"
            },
            "name": {
              "type": "string",
              "description": "Label shown when this step fails"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "log"
          ],
          "additionalProperties": false,
          "properties": {
            "log": {
              "type": "string",
              "description": "Regular expression; waits until the app (or `from:` a service) prints a matching line during this scenario"
            },
            "from": {
              "type": "string",
              "description": "Service name (from the `services` option). Default: the app"
            },
            "within": {
              "type": "integer",
              "minimum": 1,
              "description": "Milliseconds to wait. Default 5000"
            },
            "name": {
              "type": "string",
              "description": "Label shown when this step fails"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "snapshot"
          ],
          "additionalProperties": false,
          "properties": {
            "snapshot": {
              "const": true,
              "description": "Compare this scenario's trace so far (requests to the app, calls to stubs, database changes; dates and UUIDs masked) with its stored snapshot. Update with vitest -u"
            },
            "mask": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Keys whose values are masked too, e.g. [token]"
            },
            "name": {
              "type": "string",
              "description": "Label shown when this step fails"
            }
          }
        }
      ]
    },
    "matcher": {
      "type": "object",
      "description": "Value matcher: {$type}, {$regex}, {$contains} or {$any}",
      "minProperties": 1,
      "maxProperties": 1,
      "properties": {
        "$type": {
          "enum": [
            "string",
            "number",
            "boolean",
            "array",
            "object",
            "null"
          ]
        },
        "$regex": {
          "type": "string"
        },
        "$contains": {
          "type": "string"
        },
        "$any": {
          "const": true
        }
      },
      "additionalProperties": true
    }
  }
}
