{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://unpkg.com/slicetest/schema/scenario.schema.json",
  "title": "slicetest YAML scenarios",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "scenarios"
  ],
  "properties": {
    "setup": {
      "type": "array",
      "description": "Steps run at the start of every scenario",
      "items": {
        "$ref": "#/$defs/step"
      }
    },
    "define": {
      "type": "object",
      "description": "Named step lists that `use:` steps run. A list of steps, or { params, steps } for values given with `with:`",
      "additionalProperties": {
        "oneOf": [
          {
            "type": "array",
            "items": {
              "$ref": "#/$defs/step"
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "steps"
            ],
            "properties": {
              "params": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "steps": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/step"
                }
              }
            }
          }
        ]
      }
    },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "steps"
        ],
        "properties": {
          "name": {
            "type": "string",
            "description": "May use {{field}} from `each` rows"
          },
          "each": {
            "type": "array",
            "items": {
              "type": "object"
            },
            "description": "Run once per row; row fields become variables"
          },
          "skip": {
            "type": "boolean"
          },
          "only": {
            "type": "boolean"
          },
          "timeout": {
            "type": "integer"
          },
          "steps": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/step"
            }
          }
        }
      }
    }
  },
  "$defs": {
    "step": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "stub"
          ],
          "additionalProperties": false,
          "properties": {
            "stub": {
              "type": "string",
              "description": "Stub name (declared in `stubs`). Registers a route on it."
            },
            "name": {
              "type": "string",
              "description": "Label shown when this step fails"
            },
            "on": {
              "type": "string",
              "pattern": "^([A-Za-z]+|\\*)\\s+/\\S*$",
              "description": "METHOD /path, e.g. POST /polls"
            },
            "when": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "query": {
                  "type": "object"
                },
                "headers": {
                  "type": "object"
                },
                "json": {
                  "description": "Subset of the request JSON"
                },
                "form": {
                  "type": "object",
                  "description": "Subset of a form-encoded body's fields; bracket keys are nested (metadata[order] → metadata: { order })"
                },
                "body": {},
                "variables": {
                  "description": "Subset of the GraphQL variables (with `graphql`)"
                }
              }
            },
            "reply": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "status": {
                  "type": "integer"
                },
                "headers": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string"
                  }
                },
                "body": {
                  "description": "String, or anything else to send as JSON. May use {{call.params.x}}, {{call.json.x}}, {{call.query.x}}"
                },
                "sse": {
                  "type": "array",
                  "description": "A streamed reply (Server-Sent Events), instead of body: a list of { event, data, id }. Data that isn't a string is sent as JSON",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "data"
                    ],
                    "properties": {
                      "event": {
                        "type": "string"
                      },
                      "data": {},
                      "id": {
                        "type": "string"
                      }
                    }
                  }
                },
                "data": {
                  "description": "GraphQL `data` (with `graphql`): the reply's body is { data, errors }"
                },
                "errors": {
                  "type": "array",
                  "description": "GraphQL errors (with `graphql`): messages or { message, path, extensions }",
                  "items": {
                    "oneOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "object",
                        "required": [
                          "message"
                        ]
                      }
                    ]
                  }
                }
              },
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "body",
                      "sse"
                    ]
                  },
                  {
                    "required": [
                      "body",
                      "data"
                    ]
                  },
                  {
                    "required": [
                      "body",
                      "errors"
                    ]
                  },
                  {
                    "required": [
                      "sse",
                      "data"
                    ]
                  },
                  {
                    "required": [
                      "sse",
                      "errors"
                    ]
                  }
                ]
              }
            },
            "sequence": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "status": {
                    "type": "integer"
                  },
                  "headers": {
                    "type": "object",
                    "additionalProperties": {
                      "type": "string"
                    }
                  },
                  "body": {
                    "description": "String, or anything else to send as JSON. May use {{call.params.x}}, {{call.json.x}}, {{call.query.x}}"
                  },
                  "sse": {
                    "type": "array",
                    "description": "A streamed reply (Server-Sent Events), instead of body: a list of { event, data, id }. Data that isn't a string is sent as JSON",
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "data"
                      ],
                      "properties": {
                        "event": {
                          "type": "string"
                        },
                        "data": {},
                        "id": {
                          "type": "string"
                        }
                      }
                    }
                  },
                  "data": {
                    "description": "GraphQL `data` (with `graphql`): the reply's body is { data, errors }"
                  },
                  "errors": {
                    "type": "array",
                    "description": "GraphQL errors (with `graphql`): messages or { message, path, extensions }",
                    "items": {
                      "oneOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "object",
                          "required": [
                            "message"
                          ]
                        }
                      ]
                    }
                  }
                },
                "not": {
                  "anyOf": [
                    {
                      "required": [
                        "body",
                        "sse"
                      ]
                    },
                    {
                      "required": [
                        "body",
                        "data"
                      ]
                    },
                    {
                      "required": [
                        "body",
                        "errors"
                      ]
                    },
                    {
                      "required": [
                        "sse",
                        "data"
                      ]
                    },
                    {
                      "required": [
                        "sse",
                        "errors"
                      ]
                    }
                  ]
                }
              },
              "minItems": 1
            },
            "networkError": {
              "const": true
            },
            "times": {
              "type": "integer",
              "minimum": 0
            },
            "delay": {
              "type": "integer",
              "minimum": 0
            },
            "graphql": {
              "type": "string",
              "description": "A GraphQL operation (its operationName, or the name in the document), instead of METHOD /path. Matches POST and GET GraphQL requests to any path"
            },
            "optional": {
              "type": "boolean",
              "description": "The app may not call this route: strictStubs doesn't report it as unused"
            }
          },
          "oneOf": [
            {
              "required": [
                "on"
              ],
              "not": {
                "required": [
                  "graphql"
                ]
              }
            },
            {
              "required": [
                "graphql"
              ],
              "not": {
                "required": [
                  "on"
                ]
              }
            }
          ]
        },
        {
          "type": "object",
          "required": [
            "request"
          ],
          "additionalProperties": false,
          "properties": {
            "request": {
              "type": "string",
              "description": "Request to the app: METHOD /path"
            },
            "name": {
              "type": "string",
              "description": "Label shown when this step fails"
            },
            "headers": {
              "type": "object"
            },
            "query": {
              "type": "object"
            },
            "json": {},
            "form": {
              "type": "object"
            },
            "body": {
              "type": "string"
            },
            "follow": {
              "type": "boolean"
            },
            "auth": {
              "description": "Send Authorization: Bearer with a token from the auth issuer: true, or the token's claims",
              "oneOf": [
                {
                  "const": true
                },
                {
                  "type": "object"
                }
              ]
            },
            "webhook": {
              "type": "object",
              "description": "Sign the body as this provider delivers webhooks",
              "required": [
                "provider",
                "secret"
              ],
              "additionalProperties": false,
              "properties": {
                "provider": {
                  "oneOf": [
                    {
                      "enum": [
                        "stripe",
                        "github",
                        "slack",
                        "shopify",
                        "standard"
                      ]
                    },
                    {
                      "type": "object",
                      "required": [
                        "header"
                      ],
                      "additionalProperties": false,
                      "properties": {
                        "header": {
                          "type": "string"
                        },
                        "algorithm": {
                          "type": "string"
                        },
                        "encoding": {
                          "enum": [
                            "hex",
                            "base64"
                          ]
                        },
                        "prefix": {
                          "type": "string"
                        }
                      }
                    }
                  ]
                },
                "secret": {
                  "type": "string",
                  "description": "The signing secret the app is configured with"
                },
                "event": {
                  "type": "string",
                  "description": "Event type, e.g. X-GitHub-Event"
                },
                "stale": {
                  "type": "boolean",
                  "description": "Signed ten minutes ago"
                },
                "invalidSignature": {
                  "type": "boolean",
                  "description": "Signed with a different secret"
                }
              }
            },
            "concurrency": {
              "type": "integer",
              "minimum": 1,
              "description": "Send the request this many times at once, to provoke races. `expect` applies to every response"
            },
            "expect": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "status": {
                  "type": [
                    "integer",
                    "string"
                  ]
                },
                "headers": {
                  "type": "object"
                },
                "json": {
                  "description": "Subset of the response JSON"
                },
                "text": {},
                "statuses": {
                  "type": "object",
                  "propertyNames": {
                    "pattern": "^\\d{3}$"
                  },
                  "additionalProperties": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "description": "With `concurrency`: how many responses have each status, e.g. { 201: 1, 409: 9 }"
                },
                "queries": {
                  "type": "integer",
                  "minimum": 0,
                  "description": "At most this many SQL statements for this request, not counting BEGIN/COMMIT (needs db.queries)"
                },
                "schema": {
                  "description": "A JSON Schema the response JSON must match: inline, or a file relative to this one with an optional pointer, e.g. ../openapi.yaml#/components/schemas/Poll",
                  "oneOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "object"
                    }
                  ]
                }
              }
            },
            "capture": {
              "type": "object",
              "description": "Save values as variables for later steps, e.g. { pollId: json.id }",
              "additionalProperties": {
                "type": "string"
              }
            },
            "graphql": {
              "description": "Send a GraphQL operation as the JSON body: the query, or { query, variables, operationName }. A response with `errors` fails the step unless `expect.json` names `errors`",
              "oneOf": [
                {
                  "type": "string"
                },
                {
                  "type": "object",
                  "required": [
                    "query"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "query": {
                      "type": "string"
                    },
                    "variables": {
                      "type": "object"
                    },
                    "operationName": {
                      "type": "string"
                    }
                  }
                }
              ]
            }
          },
          "not": {
            "anyOf": [
              {
                "required": [
                  "graphql",
                  "json"
                ]
              },
              {
                "required": [
                  "graphql",
                  "form"
                ]
              },
              {
                "required": [
                  "graphql",
                  "body"
                ]
              }
            ]
          }
        },
        {
          "type": "object",
          "required": [
            "submit"
          ],
          "additionalProperties": false,
          "properties": {
            "submit": {
              "oneOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "const": true
                }
              ],
              "description": "Submit a form of the page the last request returned, as a browser with JavaScript off would (hidden fields such as CSRF tokens and Next.js server action ids included). Names the button to press by its text, value, name or id; `true` for the form's only button"
            },
            "name": {
              "type": "string",
              "description": "Label shown when this step fails"
            },
            "form": {
              "type": [
                "string",
                "integer"
              ],
              "description": "The form by id, name or 0-based position, when the page has several"
            },
            "fields": {
              "type": "object",
              "description": "Values typed into the form by field name; true / false / a list of values check checkboxes and radios",
              "additionalProperties": {
                "oneOf": [
                  {
                    "type": [
                      "string",
                      "number",
                      "boolean"
                    ]
                  },
                  {
                    "type": "array",
                    "items": {
                      "type": [
                        "string",
                        "number"
                      ]
                    }
                  }
                ]
              }
            },
            "headers": {
              "type": "object"
            },
            "follow": {
              "type": "boolean"
            },
            "expect": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "status": {
                  "type": [
                    "integer",
                    "string"
                  ]
                },
                "headers": {
                  "type": "object"
                },
                "json": {
                  "description": "Subset of the response JSON"
                },
                "text": {},
                "schema": {
                  "description": "A JSON Schema the response JSON must match: inline, or a file relative to this one with an optional pointer, e.g. ../openapi.yaml#/components/schemas/Poll",
                  "oneOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "object"
                    }
                  ]
                }
              }
            },
            "capture": {
              "type": "object",
              "description": "Save values as variables for later steps, e.g. { pollId: json.id }",
              "additionalProperties": {
                "type": "string"
              }
            }
          }
        },
        {
          "type": "object",
          "required": [
            "insert",
            "rows"
          ],
          "additionalProperties": false,
          "properties": {
            "insert": {
              "type": "string",
              "description": "Table to insert into"
            },
            "name": {
              "type": "string",
              "description": "Label shown when this step fails"
            },
            "rows": {
              "type": [
                "object",
                "array"
              ]
            },
            "capture": {
              "type": "object",
              "description": "Save values as variables for later steps, e.g. { pollId: json.id }",
              "additionalProperties": {
                "type": "string"
              }
            }
          }
        },
        {
          "type": "object",
          "required": [
            "make"
          ],
          "additionalProperties": false,
          "properties": {
            "make": {
              "type": "string",
              "description": "Table to make rows in: required columns and parent rows are filled from the schema"
            },
            "name": {
              "type": "string",
              "description": "Label shown when this step fails"
            },
            "rows": {
              "type": [
                "object",
                "array"
              ],
              "description": "Columns to set: a mapping, or a list of mappings for several rows"
            },
            "count": {
              "type": "integer",
              "minimum": 1,
              "description": "Make this many rows, each with `rows`"
            },
            "capture": {
              "type": "object",
              "description": "Save values as variables for later steps, e.g. { orderId: row.id }",
              "additionalProperties": {
                "type": "string"
              }
            }
          }
        },
        {
          "type": "object",
          "required": [
            "chaos"
          ],
          "additionalProperties": false,
          "properties": {
            "chaos": {
              "type": "string",
              "description": "Stub to inject faults into, for the rest of the scenario"
            },
            "name": {
              "type": "string",
              "description": "Label shown when this step fails"
            },
            "failFirst": {
              "type": "integer",
              "minimum": 0,
              "description": "Fail the first n calls, then answer normally"
            },
            "errorRate": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "description": "Share of calls answered with an error status"
            },
            "statuses": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "integer",
                "minimum": 400,
                "maximum": 599
              },
              "description": "Error statuses to pick from (default 500, 502, 503)"
            },
            "networkErrorRate": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "description": "Share of calls whose connection is dropped"
            },
            "latency": {
              "oneOf": [
                {
                  "type": "number"
                },
                {
                  "type": "array",
                  "items": {
                    "type": "number"
                  },
                  "minItems": 2,
                  "maxItems": 2
                }
              ],
              "description": "Extra delay in ms, or [min, max]"
            },
            "seed": {
              "type": "integer",
              "description": "Seed for the random faults"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "sql"
          ],
          "additionalProperties": false,
          "properties": {
            "sql": {
              "type": "string",
              "description": "SQL to run ($1, $2 … for params)"
            },
            "name": {
              "type": "string",
              "description": "Label shown when this step fails"
            },
            "params": {
              "type": "array"
            },
            "expect": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "rows": {
                  "type": "array",
                  "description": "Rows in order; each row may omit columns"
                },
                "count": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            },
            "capture": {
              "type": "object",
              "description": "Save values as variables for later steps, e.g. { pollId: json.id }",
              "additionalProperties": {
                "type": "string"
              }
            },
            "within": {
              "type": "integer",
              "minimum": 1,
              "description": "Retry this step for up to this many milliseconds, for effects the app applies asynchronously"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "db"
          ],
          "additionalProperties": false,
          "properties": {
            "db": {
              "type": "string",
              "description": "Table to read"
            },
            "name": {
              "type": "string",
              "description": "Label shown when this step fails"
            },
            "where": {
              "type": "object",
              "description": "null = IS NULL, list = IN"
            },
            "orderBy": {
              "type": [
                "string",
                "array"
              ]
            },
            "expect": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "rows": {
                  "type": "array",
                  "description": "Rows in order; each row may omit columns"
                },
                "count": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            },
            "capture": {
              "type": "object",
              "description": "Save values as variables for later steps, e.g. { pollId: json.id }",
              "additionalProperties": {
                "type": "string"
              }
            },
            "within": {
              "type": "integer",
              "minimum": 1,
              "description": "Retry this step for up to this many milliseconds, for effects the app applies asynchronously"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "received"
          ],
          "additionalProperties": false,
          "properties": {
            "received": {
              "type": "string",
              "description": "Stub name. Asserts the app called it."
            },
            "name": {
              "type": "string",
              "description": "Label shown when this step fails"
            },
            "call": {
              "type": "string",
              "pattern": "^([A-Za-z]+|\\*)\\s+/\\S*$",
              "description": "METHOD /path, e.g. POST /polls"
            },
            "when": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "query": {
                  "type": "object"
                },
                "headers": {
                  "type": "object"
                },
                "json": {
                  "description": "Subset of the request JSON"
                },
                "form": {
                  "type": "object",
                  "description": "Subset of a form-encoded body's fields; bracket keys are nested (metadata[order] → metadata: { order })"
                },
                "body": {},
                "variables": {
                  "description": "Subset of the GraphQL variables (with `graphql`)"
                }
              }
            },
            "times": {
              "type": "integer",
              "minimum": 0,
              "description": "Exact count; default: at least once"
            },
            "within": {
              "type": "integer",
              "minimum": 1,
              "description": "Retry this step for up to this many milliseconds, for effects the app applies asynchronously"
            },
            "graphql": {
              "type": "string",
              "description": "A GraphQL operation (its operationName, or the name in the document), instead of METHOD /path. Matches POST and GET GraphQL requests to any path"
            }
          },
          "not": {
            "required": [
              "call",
              "graphql"
            ]
          }
        },
        {
          "type": "object",
          "required": [
            "changes"
          ],
          "additionalProperties": false,
          "properties": {
            "changes": {
              "type": "object",
              "description": "The database changed exactly in these tables since the scenario started (or the last checkpoint). Unlisted tables must be unchanged.",
              "additionalProperties": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "inserted": {
                    "oneOf": [
                      {
                        "type": "integer",
                        "minimum": 0
                      },
                      {
                        "type": "array",
                        "items": {
                          "type": "object"
                        }
                      }
                    ],
                    "description": "Count, or subset rows"
                  },
                  "updated": {
                    "oneOf": [
                      {
                        "type": "integer",
                        "minimum": 0
                      },
                      {
                        "type": "array",
                        "items": {
                          "type": "object"
                        }
                      }
                    ],
                    "description": "Count, or subset rows (after the update)"
                  },
                  "deleted": {
                    "oneOf": [
                      {
                        "type": "integer",
                        "minimum": 0
                      },
                      {
                        "type": "array",
                        "items": {
                          "type": "object"
                        }
                      }
                    ],
                    "description": "Count, or subset rows"
                  }
                }
              }
            },
            "name": {
              "type": "string",
              "description": "Label shown when this step fails"
            },
            "within": {
              "type": "integer",
              "minimum": 1,
              "description": "Retry this step for up to this many milliseconds, for effects the app applies asynchronously"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "set"
          ],
          "additionalProperties": false,
          "properties": {
            "set": {
              "type": "object",
              "minProperties": 1,
              "propertyNames": {
                "pattern": "^[A-Za-z_]\\w*$"
              },
              "description": "Variables for later steps, e.g. { orderId: \"{{$uuid}}\", expires: \"{{$now+1d}}\" }"
            },
            "name": {
              "type": "string",
              "description": "Label shown when this step fails"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "checkpoint"
          ],
          "additionalProperties": false,
          "properties": {
            "checkpoint": {
              "const": true,
              "description": "Later `changes` steps only see what happens after this step"
            },
            "name": {
              "type": "string",
              "description": "Label shown when this step fails"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "log"
          ],
          "additionalProperties": false,
          "properties": {
            "log": {
              "type": "string",
              "description": "Regular expression; waits until the app (or `from:` a service) prints a matching line during this scenario"
            },
            "from": {
              "type": "string",
              "description": "Service name (from the `services` option). Default: the app"
            },
            "within": {
              "type": "integer",
              "minimum": 1,
              "description": "Milliseconds to wait. Default 5000"
            },
            "name": {
              "type": "string",
              "description": "Label shown when this step fails"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "snapshot"
          ],
          "additionalProperties": false,
          "properties": {
            "snapshot": {
              "const": true,
              "description": "Compare this scenario's trace so far (requests to the app, calls to stubs, database changes; dates and UUIDs masked) with its stored snapshot. Update with vitest -u"
            },
            "mask": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Keys whose values are masked too, e.g. [token]"
            },
            "name": {
              "type": "string",
              "description": "Label shown when this step fails"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "mail"
          ],
          "additionalProperties": false,
          "properties": {
            "mail": {
              "type": "object",
              "additionalProperties": false,
              "description": "The app sent mail matching these fields (needs `mail: true` in the config). to/from are exact addresses; subject/text/html are substrings. {} matches any message",
              "properties": {
                "to": {
                  "oneOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "object",
                      "required": [
                        "$regex"
                      ],
                      "additionalProperties": false,
                      "properties": {
                        "$regex": {
                          "type": "string"
                        }
                      }
                    }
                  ]
                },
                "from": {
                  "oneOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "object",
                      "required": [
                        "$regex"
                      ],
                      "additionalProperties": false,
                      "properties": {
                        "$regex": {
                          "type": "string"
                        }
                      }
                    }
                  ]
                },
                "subject": {
                  "oneOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "object",
                      "required": [
                        "$regex"
                      ],
                      "additionalProperties": false,
                      "properties": {
                        "$regex": {
                          "type": "string"
                        }
                      }
                    }
                  ]
                },
                "text": {
                  "oneOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "object",
                      "required": [
                        "$regex"
                      ],
                      "additionalProperties": false,
                      "properties": {
                        "$regex": {
                          "type": "string"
                        }
                      }
                    }
                  ]
                },
                "html": {
                  "oneOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "object",
                      "required": [
                        "$regex"
                      ],
                      "additionalProperties": false,
                      "properties": {
                        "$regex": {
                          "type": "string"
                        }
                      }
                    }
                  ]
                }
              }
            },
            "times": {
              "type": "integer",
              "minimum": 0,
              "description": "Exact number of matching messages. Default: at least one"
            },
            "within": {
              "type": "integer",
              "minimum": 1,
              "description": "Milliseconds to wait. Default 5000"
            },
            "capture": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              },
              "description": "Values of the last matching message: subject, text, html, from, to.0, links.0"
            },
            "name": {
              "type": "string",
              "description": "Label shown when this step fails"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "use"
          ],
          "additionalProperties": false,
          "properties": {
            "use": {
              "type": "string",
              "description": "Run the steps of a `define:` entry; what they capture is visible afterwards"
            },
            "name": {
              "type": "string",
              "description": "Label shown when this step fails"
            },
            "with": {
              "type": "object",
              "description": "Values for the definition's params, available as {{param}} inside it"
            }
          }
        }
      ]
    },
    "matcher": {
      "type": "object",
      "description": "Value matcher: {$type}, {$regex}, {$contains} or {$any}",
      "minProperties": 1,
      "maxProperties": 1,
      "properties": {
        "$type": {
          "enum": [
            "string",
            "number",
            "boolean",
            "array",
            "object",
            "null"
          ]
        },
        "$regex": {
          "type": "string"
        },
        "$contains": {
          "type": "string"
        },
        "$any": {
          "const": true
        }
      },
      "additionalProperties": true
    }
  }
}
