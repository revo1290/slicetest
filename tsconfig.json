{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "declaration": true,
    "outDir": "dist",
    "rootDir": ".",
    "paths": {
      "slicetest": [
        "./src/index.ts"
      ]
    }
  },
  "include": [
    "src",
    "test",
    "examples/**/*.ts",
    "vitest.config.ts"
  ]
}
