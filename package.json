{
  "name": "slicetest",
  "version": "0.6.1",
  "description": "Framework-agnostic slice tests: drive a real app process over HTTP with a real Postgres, MySQL or SQLite and stubbed outbound APIs, checked against OpenAPI contracts.",
  "keywords": [
    "testing",
    "integration-testing",
    "slice-test",
    "api-testing",
    "postgres",
    "mysql",
    "sqlite",
    "stub",
    "mock-server",
    "vitest",
    "vitest-plugin",
    "yaml",
    "testcontainers",
    "language-agnostic",
    "openapi",
    "contract-testing",
    "graphql",
    "jwt",
    "oidc",
    "webhooks",
    "chaos-testing",
    "n-plus-one",
    "test-data-factory"
  ],
  "author": "pon-bok",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/revo1290/slicetest.git"
  },
  "homepage": "https://github.com/revo1290/slicetest#readme",
  "bugs": {
    "url": "https://github.com/revo1290/slicetest/issues"
  },
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./vitest": {
      "types": "./dist/vitest.d.ts",
      "default": "./dist/vitest.js"
    },
    "./yaml": {
      "types": "./dist/yaml.d.ts",
      "default": "./dist/yaml.js"
    }
  },
  "files": [
    "dist",
    "preload",
    "schema"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:dist": "npm run build && tsc -p examples/tsconfig.dist.json && vitest run --config examples/vitest.dist.config.ts && node dist/cli.js --config examples/slicetest.config.yaml && node test/record-dist.mjs",
    "prepublishOnly": "npm run typecheck && npm run build"
  },
  "peerDependencies": {
    "@testcontainers/mysql": ">=11",
    "mysql2": ">=3",
    "vitest": ">=4"
  },
  "dependencies": {
    "@testcontainers/postgresql": "^12.2.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "pg": "^8.23.0",
    "testcontainers": "^12.2.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "@testcontainers/mysql": "^12.2.0",
    "@types/node": "^26.6.3",
    "@types/pg": "^8.23.1",
    "mysql2": "^3.24.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  },
  "bin": {
    "slicetest": "dist/cli.js"
  },
  "peerDependenciesMeta": {
    "mysql2": {
      "optional": true
    },
    "@testcontainers/mysql": {
      "optional": true
    }
  }
}
